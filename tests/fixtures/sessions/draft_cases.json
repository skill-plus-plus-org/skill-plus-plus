{
 "about": "What a drafted SKILL.md must contain, per case. Fixed before the first draft runs (tests/benchmarks/draft_check.py). A concept is present when every pattern in `all` matches inside one numbered step of the procedure; `after` searches only steps after that concept's step; `max_step` caps where it may first appear. Order rules compare first-step numbers. Settings are one-off values from the run that may appear only hedged. Patterns are case-insensitive regexes. Revised 2026-09-22 after the first four drafts, for how drafts are written, not what they must contain: steps may be ### subheadings; a question item may wrap; settings asked about under Open questions are not rules; `affirmative` concepts skip negated sentences; word boundaries on the explore and read verbs (\"reader\" had matched \"read\"), with \"assess\" added. Also: affirmative concepts join wrapped lines before splitting sentences; F1 is a plan before code (reading is implied, and F1 < F3 keeps it first); F2 accepts the same waiting words as D4.",
 "hedge": "e\\.g\\.|for example|such as|if the user|the user'?s|given|asked|requested",
 "cases": {
  "draft.code.feature": {
   "session": "C-V1",
   "concepts": {
    "F1": {
     "label": "a plan before any code",
     "all": [
      "\\b(propose|suggest|plan|assess)"
     ]
    },
    "F2": {
     "label": "no edits before agreement",
     "all": [
      "before (editing|changing|implementing)|without (editing|changing)|don'?t (edit|change|implement)|do not (edit|change|implement)|no edits|agree|confirm|approv|go.?ahead|wait for"
     ]
    },
    "F3": {
     "label": "implement",
     "all": [
      "implement|make the change|write the code"
     ],
     "affirmative": true
    },
    "F4": {
     "label": "add tests",
     "all": [
      "add (a |the )?tests?|write (a |the )?tests?"
     ]
    },
    "F5": {
     "label": "run the whole suite",
     "all": [
      "(all|whole|full|entire) (the )?(tests|test suite|suite)"
     ]
    },
    "F6": {
     "label": "commit",
     "all": [
      "commit"
     ]
    }
   },
   "order": [
    [
     "F1",
     "<",
     "F3"
    ],
    [
     "F2",
     "<=",
     "F3"
    ],
    [
     "F3",
     "<=",
     "F4"
    ],
    [
     "F4",
     "<=",
     "F5"
    ],
    [
     "F5",
     "<",
     "F6"
    ]
   ],
   "meta_forbid": [
    "min-length",
    "min_length",
    "wordfreq",
    "textkit"
   ],
   "body_limit": {
    "id": "F8",
    "label": "about a feature, not this one",
    "pattern": "min-length|min_length|wordfreq|textkit",
    "max": 2
   }
  },
  "draft.code.refactor": {
   "session": "C-N1",
   "concepts": {
    "R1": {
     "label": "explore first",
     "all": [
      "\\b(read|reads|reading|look at|inspect|explore)\\b",
      "\\b(propose|suggest|plan|simplif|assess)"
     ]
    },
    "R2": {
     "label": "behaviour must not change",
     "all": [
      "behaviou?r",
      "unchanged|same|preserve|keep|not change|don'?t change"
     ]
    },
    "R3": {
     "label": "tests prove it",
     "all": [
      "run (the )?(existing |full |whole )?(test|suite)"
     ]
    },
    "R4": {
     "label": "commit",
     "all": [
      "commit"
     ]
    }
   },
   "order": [
    [
     "R1",
     "<",
     "R3"
    ],
    [
     "R3",
     "<=",
     "R4"
    ]
   ],
   "absent": [
    {
     "id": "R5",
     "label": "not a feature",
     "pattern": "\\badd(ing)? (a |an )?new (option|flag|argument|feature|behaviou?r)"
    }
   ],
   "meta_forbid": [
    "slugify",
    "textkit"
   ]
  },
  "draft.procedure.deck": {
   "session": "P-V1",
   "concepts": {
    "D1": {
     "label": "read the source",
     "all": [
      "\\b(read|reads|reading)\\b|\\bsource\\b|\\bmaterial\\b"
     ]
    },
    "D2": {
     "label": "outline first",
     "all": [
      "outline|propose (the )?(content|slides|structure)"
     ]
    },
    "D3": {
     "label": "check against the source",
     "all": [
      "check|verify|backed",
      "source|material|against"
     ]
    },
    "D4": {
     "label": "wait for approval",
     "all": [
      "approv|confirm|sign.?off|go.?ahead|wait for"
     ],
     "after": "D3"
    },
    "D5": {
     "label": "build",
     "all": [
      "build|create|generate",
      "pptx|deck|slides|presentation"
     ],
     "affirmative": true
    },
    "D6": {
     "label": "verify the result",
     "all": [
      "open|check|verify",
      "file|deck|slides|pptx"
     ],
     "after": "D5"
    }
   },
   "order": [
    [
     "D2",
     "<",
     "D3"
    ],
    [
     "D3",
     "<=",
     "D4"
    ],
    [
     "D4",
     "<=",
     "D5"
    ],
    [
     "D5",
     "<",
     "D6"
    ]
   ],
   "settings": [
    "\\b(6|six) slides",
    "\\b(10|ten)[- ]minute",
    "\\b(3|three) (to|-) ?(4|four) bullets"
   ],
   "meta_forbid": [
    "skillpp",
    "readme"
   ]
  },
  "draft.procedure.post": {
   "session": "P-F1",
   "concepts": {
    "P1": {
     "label": "read the source first",
     "all": [
      "\\bread\\b",
      "source|notes|document|material"
     ],
     "max_step": 2
    },
    "P2": {
     "label": "a length limit",
     "all": [
      "word|length",
      "limit|cap|count|between|maximum"
     ]
    },
    "P3": {
     "label": "count with a tool, not by estimate",
     "all": [
      "\\bwc\\b|\\bmeasure|with a (tool|command)|count (the )?words (with|using)|word.?count (tool|command)"
     ]
    },
    "P4": {
     "label": "check claims against the source",
     "all": [
      "check|verify|fact.?check|match",
      "claim|fact|statement",
      "source|notes|backed"
     ]
    }
   },
   "order": [
    [
     "P1",
     "<",
     "P3"
    ],
    [
     "P1",
     "<",
     "P4"
    ]
   ],
   "settings": [
    "\\b120\\b",
    "\\b180\\b",
    "three (short )?takeaways",
    "question at the end|closing question|end with a question"
   ],
   "meta_forbid": [
    "weather",
    "notes.md",
    "skycast"
   ]
  }
 }
